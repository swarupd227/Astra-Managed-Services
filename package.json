{
  "name": "astra-for-managed-services",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Astra for Managed Services — the agentic managed-services platform by Artizent",
  "scripts": {
    "dev": "concurrently -n gateway,web -c yellow,cyan \"npm:gateway\" \"npm:web\"",
    "web": "vite",
    "gateway": "node server/agent.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test \"server/**/*.test.mjs\"",
    "start": "node server/agent.mjs",
    "db:migrate": "node server/migrate.mjs",
    "db:ingest": "node server/ingest.mjs",
    "db:prune": "node server/prune.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.1",
    "lucide-react": "^0.454.0",
    "pg": "^8.23.1",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
